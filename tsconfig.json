{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["src/codex/*.ts", "src/npc/*.ts", "scripts/codex-*.ts", "scripts/npc-*.ts", "tests/codex-*.test.ts", "vitest.config.ts"]
}
